rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    match /markets/default {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'confirmed'
        && request.resource.data.stallId is string
        && request.resource.data.renterName is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.startDate <= request.resource.data.endDate;
      allow update: if signedIn()
        && resource.data.status == 'confirmed'
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'stallId',
              'renterName',
              'contact',
              'totalPrice',
              'startDate',
              'endDate',
              'notes'
            ])
            && request.resource.data.status == 'confirmed'
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.stallId is string
            && request.resource.data.renterName is string
            && request.resource.data.startDate is string
            && request.resource.data.endDate is string
            && request.resource.data.startDate <= request.resource.data.endDate
          )
        );
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }
  }
}
